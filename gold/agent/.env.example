# Gold Trading Bot Environment Configuration
# Copy this to .env and fill in your values

# Broker API (only needed for live trading - DISABLED by default)
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=

# Data source
DATA_PROVIDER=tradingview  # tradingview | yfinance | oanda | alpha_vantage
ALPHA_VANTAGE_KEY=

# TradingView credentials (optional — works without login for most symbols)
TV_USERNAME=
TV_PASSWORD=

# OANDA Practice Account (FREE — for real-time tick streaming)
# Sign up at https://www.oanda.com → Practice/Demo account
# Then: Account → Manage API Access → Generate Token
OANDA_TOKEN=
OANDA_ACCOUNT_ID=

# Live trading feature flag — MUST be explicitly set to enable live trading
# WARNING: Do NOT set this to true unless you have passed ALL deployment gates
ENABLE_LIVE_TRADING=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Paper trading
PAPER_TRADE_INITIAL_EQUITY=100000.0
